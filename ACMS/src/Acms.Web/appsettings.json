{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Acms": "Server=YOUR_SQL_SERVER;Database=ACMS;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Database": {
    "Provider": "SqlServer",
    "EnsureCreated": false,
    "SeedDemoServers": false
  },

  "Acms": {
    "Security": {
      "RoleMappings": {
        "Administrator": [ "COMPANY\\ACMS-Administrators" ],
        "Engineer": [ "COMPANY\\ACMS-Engineers" ],
        "Viewer": [ "COMPANY\\ACMS-Viewers" ]
      },
      "DevAuthentication": {
        "Enabled": false
      }
    },
    "Ui": {
      "SummaryAttributes": [ "EQUIPMENT", "MODEL", "LOCATION", "SPEED_SPEC" ]
    }
  },

  "Awacs": {
    "UseFake": false,
    "WorkstationDataPath": "template/wsdata.xml",
    "UpdatePath": "template/wswoupdate.html",
    "UpdateAttributeFormat": "Quoted",
    "UpdateFailureMarkers": [],
    "TimeoutSeconds": 30,
    "ReadRetryCount": 2,
    "MaxIdsPerRequest": 50,
    "UseDefaultCredentials": true,
    "WorkstationElementNames": [ "ws", "workstation" ],
    "WorkstationIdNames": [ "WSID", "id", "name" ]
  },

  "EquipmentRules": {
    "ReadOnlyAttributes": [ "WSID", "UPDATED" ],
    "MaxValueLength": 256,
    "AllowNewAttributes": false,
    "KnownAttributes": [
      "AREA", "COMPUTER", "CONTROL", "EQUIPMENT", "IPADDRESS", "LAST_DWO", "LICENSE", "LOCATION",
      "MAC", "MAPLOC", "MODEL", "RECIPELOAD", "SPEED_SPEC", "SRCFILE", "VERSION",
      "WSUS", "WSUS_SERVER", "WSUS_STATUS", "XPEIMAGE", "XPOS", "YPOS"
    ]
  }
}
