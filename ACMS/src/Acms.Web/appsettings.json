{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Acms": "Server=YOUR_SQL_SERVER;Database=ACMS;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Database": {
    "Provider": "SqlServer",
    "EnsureCreated": false,
    "SeedDemoServers": false
  },

  "Acms": {
    "Security": {
      "RoleMappings": {
        "Administrator": [ "COMPANY\\ACMS-Administrators" ],
        "Engineer": [ "COMPANY\\ACMS-Engineers" ],
        "Viewer": [ "COMPANY\\ACMS-Viewers" ]
      },
      "DevAuthentication": {
        "Enabled": false
      }
    },
    "Ui": {
      "SummaryAttributes": [ "WSTYPE", "STATE", "RECIPELOAD" ]
    }
  },

  "Awacs": {
    "UseFake": false,
    "WorkstationDataPath": "template/wsdata.xml",
    "UpdatePath": "template/wswoupdate.html",
    "UpdateQueryTemplate": "ws={ws}&setwsattr={name}&value={value}",
    "UpdateFailureMarkers": [],
    "TimeoutSeconds": 30,
    "ReadRetryCount": 2,
    "UseDefaultCredentials": true,
    "WorkstationElementNames": [ "ws", "workstation" ],
    "WorkstationIdNames": [ "WSID", "id", "name" ]
  },

  "EquipmentRules": {
    "ReadOnlyAttributes": [ "WSID" ],
    "MaxValueLength": 256,
    "AllowNewAttributes": false
  }
}
